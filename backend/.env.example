# Smart Café Backend Configuration

# Server Port
PORT=5001

# Application Environment (development, production)
NODE_ENV=development

# Allowed CORS Origins (comma separated or * for dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:8080,*

# Firebase Configuration
# Option 1: Path to Firebase serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/serviceAccountKey.json

# Option 2: Inline Service Account JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option 3: Project ID (for Google Cloud / Emulator environments)
FIREBASE_PROJECT_ID=smart-cafe-yoru

# Google Gemini API Key (Optional: for live generative AI sommelier recommendations)
# If omitted, intelligent built-in Kissaten flavor-matching heuristic engine is used automatically!
# GEMINI_API_KEY=your-gemini-api-key
